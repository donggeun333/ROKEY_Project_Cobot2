<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tool_sorter_handover</name>
  <version>0.1.0</version>
  <description>Keyword-requested tool handover for the M0609 cell.</description>
  <maintainer email="jeowryu@gmail.com">jwanryu</maintainer>
  <license>Apache-2.0</license>

  <depend>tool_sorter_core</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tool_sorter_core</name>
  <version>0.1.0</version>
  <description>Unified timestamped RGB-D transform and tool sorting pipeline for Doosan M0609 and OnRobot RG2.</description>
  <maintainer email="jeowryu@gmail.com">jwanryu</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>cv_bridge</depend>
  <depend>dsr_msgs2</depend>
  <depend>geometry_msgs</depend>
  <depend>onrobot_rg_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

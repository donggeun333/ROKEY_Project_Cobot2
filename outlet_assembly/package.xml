<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>outlet_assembly</name>
  <version>0.1.0</version>
  <description>M0609 플러그 삽입(OUTLET_ASSEMBLE) — 멀티탭 구멍 인식 후 플러그 체결</description>
  <maintainer email="rokey@todo.todo">rokey</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_python</depend>
  <depend>onrobot_rg_msgs</depend>
  <!-- 13클래스 seg 모델(best.pt)·캘리브레이션(.npy)과 서비스 기반 OnRobotGripper를 가져다 쓴다 -->
  <depend>tool_sorter_core</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
